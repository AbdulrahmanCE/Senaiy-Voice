# Senaiy Voice — environment variables
# Copy to .env and fill in. Never commit .env to git.

# ─── Public-facing URL (production) ─────────────────────────────────────────
# These power the OAuth callback and the TwiML <Stream> URL.
# In dev (localhost) you can leave them blank — admin will derive from the request.
PUBLIC_DOMAIN=senaiy.solvfast.com
PUBLIC_BASE_URL=https://senaiy.solvfast.com/admin

# ─── Provider switching ────────────────────────────────────────────────────
# Each line picks the active backend. Restart bots after changing.
LLM_PROVIDER=gemini       # gemini | openai
STT_PROVIDER=deepgram     # deepgram | openai | soniox
TTS_PROVIDER=elevenlabs   # elevenlabs | openai

# ─── Google Gemini (LLM) ────────────────────────────────────────────────────
# Free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ─── Deepgram (STT, default) ────────────────────────────────────────────────
# Free $200 credit at https://console.deepgram.com — best STT TTFB.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
STT_LANGUAGE=ar

# ─── Soniox (STT alternative) ───────────────────────────────────────────────
# https://soniox.com — supports Arabic + English code-switching natively.
SONIOX_API_KEY=

# ─── OpenAI (LLM/STT alternative + Twilio metadata fetch) ───────────────────
OPENAI_API_KEY=
# OPENAI_MODEL is ignored unless LLM_PROVIDER=openai. Same for OPENAI_VOICE_ID.
OPENAI_MODEL=gpt-4o
OPENAI_VOICE_ID=alloy

# ─── ElevenLabs (TTS) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ─── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Latency / turn-detection tuning ────────────────────────────────────────
# Lower = snappier replies but may cut off mid-sentence; raise if STT misses words.
VAD_STOP_SECS=0.25
SPEECH_TIMEOUT_SECS=0.45
# ElevenLabs voice speed. Range 0.7 – 1.2 (model-dependent).
TTS_SPEED=1.2

# ─── Admin panel ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
