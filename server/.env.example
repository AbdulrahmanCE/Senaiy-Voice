# Senaiy Voice — environment variables
# Copy to .env and fill in. Never commit .env to git.

# ─── Public-facing URL (production) ─────────────────────────────────────────
# These power the OAuth callback and the TwiML <Stream> URL.
# In dev (localhost) you can leave them blank — admin will derive from the request.
PUBLIC_DOMAIN=senaiy.solvfast.com
PUBLIC_BASE_URL=https://senaiy.solvfast.com/admin

# ─── Google Gemini (LLM) ────────────────────────────────────────────────────
# Free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ─── Soniox (STT) ───────────────────────────────────────────────────────────
# https://soniox.com — supports Arabic + English code-switching
SONIOX_API_KEY=

# ─── OpenAI (kept for admin / Twilio metadata fetch only) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VOICE_ID=alloy

# ─── ElevenLabs (TTS) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ─── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Latency / turn-detection tuning ────────────────────────────────────────
# Lower = snappier replies but may cut off mid-sentence; raise if STT misses words.
VAD_STOP_SECS=0.25
SPEECH_TIMEOUT_SECS=0.45
# ElevenLabs voice speed. Range 0.7 – 1.2 (model-dependent).
TTS_SPEED=1.2

# ─── Admin panel ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
