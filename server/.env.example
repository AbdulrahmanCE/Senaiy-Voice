# Senaiy Voice — environment variables
# Copy to .env and fill in. Never commit .env to git.

# ─── Public-facing URL (production) ─────────────────────────────────────────
# These power the OAuth callback and the TwiML <Stream> URL.
# In dev (localhost) you can leave them blank — admin will derive from the request.
PUBLIC_DOMAIN=senaiy.solvfast.com
PUBLIC_BASE_URL=https://senaiy.solvfast.com/admin

# ─── OpenAI (STT + LLM) ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VOICE_ID=alloy

# ─── ElevenLabs (TTS) ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ─── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Admin panel ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
